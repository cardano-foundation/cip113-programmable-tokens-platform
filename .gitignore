# IDE and editor
.vscode/
.idea/
# Claude Code agent scratch space. Holds git worktrees — full second copies of
# this repository — which must never be committed back into the tree.
.claude/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env files (components manage their own, but catch root-level ones)
.env
.env.local
.env.*.local
# Per-environment env files carrying live credentials. `.env.*.local` does NOT match
# `.env.preview` — the middle segment is the environment, not the literal word "local" —
# so these need naming explicitly. This repo already has three `.env` variants tracked on
# a public origin because a pattern did not match the filename someone actually used.
.env.preview
.env.preprod
.env.mainnet
.env.devnet

# Logs
*.log
logs/

# Aiken (for substandards)
src/substandards/*/build/
src/substandards/*/artifacts/
src/substandards/*/docs/
